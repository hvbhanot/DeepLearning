    "# Only torch is needed - we are inspecting models, not training them.\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Two architectures to compare: deep (three narrow layers) and wide (two fat\n",
    "# ones). Note neither has activations, so both collapse to a single linear map -\n",
    "# fine here, since we are only counting parameters.\n",
    "model_deep = nn.Sequential(\n",
    "    nn.Linear(2,2),\n",
    "    nn.Linear(2,2),\n",
    "    nn.Linear(2,3),\n",
    ")\n",
    "\n",
    "model_wide = nn.Sequential(\n",
    "    nn.Linear(2,4),\n",
    "    nn.Linear(4,2)\n",
    ")\n",
    "\n",
    "model_deep,model_wide"
   ],
