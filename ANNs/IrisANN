    "# The usual loop, plus accuracy tracked per epoch:\n",
    "# argmax over axis 1 turns the 3 logits into a predicted class index.\n",
    "# Note that the largest logit and the largest probability are the same class,\n",
    "# so no softmax is needed to make a prediction.\n",
    "accuracy = []\n",
    "losses = torch.zeros(epochs)\n",
    "\n",
    "for i in range(epochs):\n",
    "  yhat = model(data.float())\n",
    "\n",
    "  loss = lossfunc(yhat,target)\n",
    "  losses[i] = loss\n",
    "\n",
    "  optimizer.zero_grad()\n",
    "  loss.backward()\n",
    "  optimizer.step()\n",
    "\n",
    "  # Calculate accuracy\n",
    "  acc = (torch.argmax(yhat,axis=1) == target).float()\n",
    "  totalacc = 100* torch.mean(acc).float()\n",
    "  accuracy.append(totalacc)\n",
    "\n"
   ],
