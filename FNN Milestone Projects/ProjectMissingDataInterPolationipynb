    "# The training loop. MSELoss for regression; y.reshape(-1,1) matches the target\n",
    "# shape to the model's (N,1) output - without it MSELoss broadcasts silently to\n",
    "# an (N,N) matrix of differences and computes nonsense.\n",
    "epochs = 1000\n",
    "lr = 1e-4\n",
    "\n",
    "sugar = model().to(device)\n",
    "\n",
    "lossFunc = nn.MSELoss()\n",
    "optimizer = torch.optim.Adam(sugar.parameters(), lr=lr, weight_decay = 0.001)\n",
    "\n",
    "dev_loss = []\n",
    "losses = torch.zeros(epochs, device=device)\n",
    "\n",
    "for epoch in range(epochs):\n",
    "\n",
    "  sugar.train()\n",
    "  batch_loss = []\n",
    "\n",
    "  for x,y in train_loader:\n",
    "\n",
    "    yhat = sugar.forward(x)\n",
    "\n",
    "    loss = lossFunc(yhat,y.reshape(-1,1))\n",
    "    batch_loss.append(loss.item())\n",
    "\n",
    "    optimizer.zero_grad()\n",
    "    loss.backward()\n",
    "    optimizer.step()\n",
    "\n",
    "  losses[epoch] = np.mean(batch_loss)\n",
    "\n",
    "  sugar.eval()\n",
    "  with torch.no_grad():\n",
    "    X,Y = next(iter(dev_loader))\n",
    "    preds = sugar.forward(X)\n",
    "\n",
    "    dev_loss.append(lossFunc(preds,Y.reshape(-1,1)))\n",
    "\n",
    "  if epoch % 250 == 0 or epoch == epochs - 1:\n",
    "    print(f'Epoch {epoch} | Train Loss : {losses[epoch].item()} | Dev Loss = {dev_loss[epoch].item()}')"
   ],
